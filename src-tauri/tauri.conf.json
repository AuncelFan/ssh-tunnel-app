{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ssh-tunnel",
  "version": "0.1.0",
  "identifier": "app.ssh-tunnel.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir frontend dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "ssh-tunnel", "width": 1120, "height": 760, "minWidth": 360, "minHeight": 480 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "publisher": "ssh-tunnel",
    "shortDescription": "Desktop SSH tunnel manager",
    "icon": ["../build/appicon.png", "../build/windows/icon.ico", "../build/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true
      }
    }
  }
}
